{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxyjachg",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b644821a-ac85-4486-939d-aa429a8bd37d","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4a5751a3961244ce87e2daf0dc1f2eed" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
